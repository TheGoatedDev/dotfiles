{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-4.6",
  "small_model": "opencode/ling-3.0-flash-fin-free",
  "disabled_providers": ["openai"],
  "lsp": true,
  "formatter": true,
  "compaction": { "auto": true, "prune": true, "tail_turns": 8 },
  "tool_output": { "max_lines": 400, "max_bytes": 16384 },
  "tools": {
    "websearch": false,
    "webfetch": false
  },
  "permission": {
    "skill": {
      "find-docs": "deny"
    },
    "webfetch": "deny",
    "exa_*": "deny"
  },
  "agent": {
    "explore": {
      "description": "Use for unknown local files, symbols, call sites, repo layout. Read-only glob/grep/read. Primary MUST Task explore instead of scanning a large tree itself. Skip if the exact path is already known.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "exa_*": "deny",
        "skill": {
          "find-docs": "deny"
        }
      }
    },
    "scout": {
      "description": "Use for library/API docs, upstream deps, and web research. ctx7 CLI (find-docs), Exa, webfetch. Primary MUST Task scout instead of guessing APIs or searching the web.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "exa_*": "allow",
        "skill": {
          "find-docs": "allow"
        },
        "bash": {
          "*": "deny",
          "npx ctx7*": "allow",
          "npx ctx7@latest *": "allow"
        }
      }
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail@4.9.0",
    "opencode-caveman@0.1.4"
  ],
  "references": {
    "obsidian": {
      "path": "~/Obsidian",
      "description": "Personal Obsidian vault. Use when looking up personal notes or knowledge not in the current project."
    }
  }
}
