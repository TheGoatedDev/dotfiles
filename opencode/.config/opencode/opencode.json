{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "compaction": { "auto": true, "prune": true, "tail_turns": 8 },
  "tool_output": { "max_lines": 400, "max_bytes": 16384 },
  "tools": {
    "websearch": false,
    "webfetch": true
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:27b-mlx": {
          "name": "Qwen3.8 27B MLX",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail@4.9.0",
    "opencode-caveman@0.1.4"
  ],
  "references": {
    "obsidian": {
      "path": "~/Obsidian",
      "description": "Personal Obsidian vault. Use when looking up personal notes or knowledge not in the current project."
    }
  }
}
