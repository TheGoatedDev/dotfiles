{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "compaction": { "auto": true, "prune": true, "tail_turns": 8 },
  "tool_output": { "max_lines": 400, "max_bytes": 16384 },
  "tools": {
    "websearch": false,
    "webfetch": true
  },
  "agent": {
    "scout": {
      "description": "Use for library/API docs, upstream deps, and web research. ctx7 CLI (find-docs), Exa, webfetch. Primary MUST Task scout instead of guessing APIs or searching the web.",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "exa_*": "allow",
        "skill": {
          "find-docs": "allow"
        },
        "bash": {
          "*": "deny",
          "npx ctx7*": "allow",
          "npx ctx7@latest *": "allow"
        }
      }
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail@4.9.0",
    "opencode-caveman@0.1.4"
  ],
  "references": {
    "obsidian": {
      "path": "~/Obsidian",
      "description": "Personal Obsidian vault. Use when looking up personal notes or knowledge not in the current project."
    }
  }
}
