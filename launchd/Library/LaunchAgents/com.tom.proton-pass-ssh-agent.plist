<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Proton Pass SSH agent: serves SSH keys from all vaults on ~/.ssh/proton-pass-agent.sock. Needs a pass-cli login. -->
    <key>Label</key>
    <string>com.tom.proton-pass-ssh-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/pass-cli</string>
        <string>ssh-agent</string>
        <string>start</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- logged out → exits fast; don't spin -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardErrorPath</key>
    <string>/tmp/proton-pass-ssh-agent.log</string>
</dict>
</plist>
