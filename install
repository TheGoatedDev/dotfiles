#!/usr/bin/env zsh
set -euo pipefail

REPO="${0:A:h}"
HOME_DIR="${HOME:A}"
FORCE=0
CHECK_ONLY=0
SKILLS_ONLY=0
STRICT_SECRETS=0
BREW_REINSTALL=0
BREW_REINSTALL_CASKS=0

usage() {
  cat <<'EOF'
Usage: ./install [options]

  --force             Backup conflicting files, then stow
  --reinstall         brew reinstall Brewfile formulae only (no casks / no sudo)
  --reinstall-casks   brew reinstall Brewfile casks only (Terminal + sudo -v)
  --check             Report drift only (no changes)
  --skills-only       Skills + opencode skill links only
  --strict            Fail if secrets file missing
  -h, --help          This help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE=1 ;;
    --reinstall) BREW_REINSTALL=1 ;;
    --reinstall-casks) BREW_REINSTALL_CASKS=1 ;;
    --check) CHECK_ONLY=1 ;;
    --skills-only) SKILLS_ONLY=1 ;;
    --strict) STRICT_SECRETS=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

log() { print -r -- "→ $*"; }
warn() { print -r -- "⚠ $*" >&2; }
die() { print -r -- "✗ $*" >&2; exit 1; }

expand_path() {
  local p="$1"
  p="${p/#\~/$HOME_DIR}"
  print -r -- "${p:A}"
}

STOW_PACKAGES=(zsh git ghostty opencode)
ZSH_PLUGINS_DIR="$(expand_path ~/.zsh/plugins)"
ZSH_PLUGIN_REPOS=(
  https://github.com/zsh-users/zsh-autosuggestions
  https://github.com/zsh-users/zsh-syntax-highlighting
)
MANIFEST="$REPO/manifest.yaml"
CUSTOM_SKILLS_DIR="$REPO/skills/custom"
AGENTS_SKILLS_DIR="$(expand_path ~/.agents/skills)"
OPENCODE_SKILLS_DIR="$(expand_path ~/.config/opencode/skills)"
OPENCODE_DIR="$(expand_path ~/.config/opencode)"
SECRETS_PATH="$(expand_path ~/.config/secrets/env)"
BREWFILE="$REPO/Brewfile"
BACKUP_ROOT="$(expand_path ~/.dotfiles-backup)/$(date +%Y%m%d-%H%M%S)"

ensure_brew() {
  if command -v brew >/dev/null 2>&1; then
    return 0
  fi
  log "Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
}

brew_reinstall_formulae() {
  [[ -f "$BREWFILE" ]] || die "Missing Brewfile"
  local line name
  log "brew reinstall (Brewfile formulae — no sudo)"
  export HOMEBREW_NO_ENV_HINTS=1
  while IFS= read -r line; do
    [[ "$line" == brew\ \"* ]] || continue
    name="${line#brew \"}"
    name="${name%%\"*}"
    [[ -n "$name" ]] || continue
    log "reinstall formula $name"
    brew reinstall "$name" || warn "reinstall failed: $name"
  done < "$BREWFILE"
}

# Casks that need multi-step privileged helpers — reinstall breaks mid-flight.
# Install/upgrade via normal `brew bundle` only; never brew reinstall.
CASK_REINSTALL_SKIP=(docker-desktop)

brew_reinstall_casks() {
  [[ -f "$BREWFILE" ]] || die "Missing Brewfile"
  local line name sudo_keeper=0 skip

  if [[ ! -t 0 || ! -t 1 || ! -t 2 ]]; then
    die "cask reinstall needs a real Terminal. Run:\n  cd $REPO && ./install --reinstall-casks"
  fi

  unset SUDO_ASKPASS SUDO_ASKPASS_REQUIRE
  log "admin password once (should stay hidden)…"
  if ! sudo -v; then
    die "sudo failed — wrong password or cancelled."
  fi

  # Refresh sudo every 10s so long casks (and brew's own sudo calls) stay authenticated
  (
    while true; do
      sudo -n true 2>/dev/null || exit 0
      sleep 10
    done
  ) &
  sudo_keeper=$!
  trap "kill $sudo_keeper 2>/dev/null || true" EXIT INT TERM

  export HOMEBREW_NO_ENV_HINTS=1
  log "brew reinstall (Brewfile casks; skips: ${(j:, :)CASK_REINSTALL_SKIP})"
  while IFS= read -r line; do
    [[ "$line" == cask\ \"* ]] || continue
    name="${line#cask \"}"
    name="${name%%\"*}"
    [[ -n "$name" ]] || continue
    skip=0
    for s in "${CASK_REINSTALL_SKIP[@]}"; do
      [[ "$name" == "$s" ]] && skip=1 && break
    done
    if (( skip )); then
      log "skip reinstall $name (use: brew install --cask $name)"
      continue
    fi
    # zulu@* are .pkg installers — reinstall is slow; only if missing from /Library/Java
    if [[ "$name" == zulu@* ]]; then
      if /usr/libexec/java_home -v "${name#zulu@}" >/dev/null 2>&1; then
        log "skip $name (JDK already registered)"
        continue
      fi
    fi
    log "reinstall cask $name"
    sudo -v 2>/dev/null || true
    brew reinstall --cask "$name" || warn "reinstall failed: $name"
  done < "$BREWFILE"

  kill $sudo_keeper 2>/dev/null || true
  trap - EXIT INT TERM
}

brew_bundle() {
  [[ -f "$BREWFILE" ]] || die "Missing Brewfile"
  if (( BREW_REINSTALL )); then
    brew_reinstall_formulae
  fi
  if (( BREW_REINSTALL_CASKS )); then
    brew_reinstall_casks
  fi
  log "brew bundle (no upgrade)"
  export HOMEBREW_NO_ENV_HINTS=1
  # Idempotent install only — don't pull multi‑GB cask upgrades mid-bootstrap
  brew bundle --file="$BREWFILE" --no-upgrade
}

ensure_stow() {
  command -v stow >/dev/null 2>&1 || brew install stow
}

backup_path() {
  local target="$1"
  local rel="${target#$HOME_DIR/}"
  local dest="$BACKUP_ROOT/$rel"
  mkdir -p "${dest:h}"
  mv "$target" "$dest"
  log "backed up $target → $dest"
}

# True if path is already a symlink into this repo
is_repo_link() {
  local target="$1"
  [[ -L "$target" ]] || return 1
  local resolved
  resolved="$(readlink "$target")"
  [[ "$resolved" == "$REPO"/* ]] && return 0
  # relative link: resolve
  local abs="${target:A}"
  [[ "$abs" == "$REPO"/* ]]
}

stow_package() {
  local pkg="$1"
  local pkg_dir="$REPO/$pkg"
  [[ -d "$pkg_dir" ]] || die "Missing package: $pkg"

  # Conflict scan: files that would be replaced
  local conflicts=()
  local f rel dest
  while IFS= read -r -d '' f; do
    rel="${f#$pkg_dir/}"
    dest="$HOME_DIR/$rel"
    [[ -e "$dest" || -L "$dest" ]] || continue
    if is_repo_link "$dest"; then
      continue
    fi
    # already correct absolute link into package
    if [[ -L "$dest" ]]; then
      local link
      link="$(readlink "$dest")"
      [[ "$link" == "$pkg_dir/$rel" || "${dest:A}" == "$f" ]] && continue
    fi
    conflicts+=("$dest")
  done < <(find "$pkg_dir" -type f -print0)

  if (( ${#conflicts[@]} > 0 )); then
    if (( FORCE )); then
      mkdir -p "$BACKUP_ROOT"
      local c
      for c in "${conflicts[@]}"; do
        backup_path "$c"
      done
    else
      warn "Conflicts for package $pkg (re-run with --force):"
      print -l -- "${conflicts[@]}"
      die "stow aborted"
    fi
  fi

  log "stow $pkg"
  stow -d "$REPO" -t "$HOME_DIR" -R "$pkg"
}

clone_zsh_plugins() {
  mkdir -p "$ZSH_PLUGINS_DIR"
  local url name dest
  for url in "${ZSH_PLUGIN_REPOS[@]}"; do
    name="${url:t}"
    name="${name%.git}"
    dest="$ZSH_PLUGINS_DIR/$name"
    if [[ -d "$dest/.git" ]]; then
      log "update plugin $name"
      git -C "$dest" pull --ff-only --quiet || warn "could not update $name"
    else
      log "clone plugin $name"
      git clone --depth 1 "$url" "$dest"
    fi
  done
}

check_secrets() {
  if [[ -f "$SECRETS_PATH" ]]; then
    log "secrets ok ($SECRETS_PATH)"
    return 0
  fi
  warn "Missing secrets file: $SECRETS_PATH"
  warn "Copy $REPO/env.example → $SECRETS_PATH && chmod 600"
  (( STRICT_SECRETS )) && die "secrets required (--strict)"
}

install_skills_external() {
  [[ -f "$MANIFEST" ]] || { warn "no manifest.yaml"; return 0; }
  mkdir -p "$AGENTS_SKILLS_DIR" "$HOME_DIR/.agents"

  # packages: under skills: in manifest.yaml — source → list of skill names.
  # Skip if already present. Agent: opencode only.
  python3 - <<'PY' "$MANIFEST" "$AGENTS_SKILLS_DIR" || true
import re, subprocess, sys
from pathlib import Path

text = Path(sys.argv[1]).read_text()
agents = Path(sys.argv[2])

# tiny indent walker for skills.packages only (no PyYAML)
lines = text.splitlines()
i = 0
in_skills = in_packages = False
skills_indent = packages_indent = None
packages: dict[str, list[str]] = {}
cur_src = None

while i < len(lines):
    raw = lines[i]
    i += 1
    if not raw.strip() or raw.lstrip().startswith("#"):
        continue
    indent = len(raw) - len(raw.lstrip(" "))
    s = raw.strip()
    if not in_skills:
        if s == "skills:" and indent == 0:
            in_skills = True
            skills_indent = indent
        continue
    if indent <= skills_indent and s.endswith(":") and s != "skills:":
        break
    if not in_packages:
        if s == "packages:":
            in_packages = True
            packages_indent = indent
        continue
    if indent <= packages_indent:
        break
    m_src = re.match(r"^([\w./-]+):\s*$", s)
    if m_src and indent == packages_indent + 2:
        cur_src = m_src.group(1)
        packages.setdefault(cur_src, [])
        continue
    m_item = re.match(r"^-\s+(\S+)\s*$", s)
    if m_item and cur_src is not None and indent > packages_indent + 2:
        packages[cur_src].append(m_item.group(1))

if not packages:
    print("⚠ no skills.packages in manifest.yaml", file=sys.stderr)
    sys.exit(0)

for src, names in packages.items():
    for skill in names:
        if (agents / skill).exists():
            print(f"→ skills skip (present): {skill}")
            continue
        cmd = [
            "npx", "--yes", "skills", "add", src,
            "-g", "-y", "-s", skill, "-a", "opencode",
        ]
        print(f"→ skills add {src} -s {skill} -a opencode")
        subprocess.run(cmd, check=False)
PY
}

link_custom_skills() {
  mkdir -p "$AGENTS_SKILLS_DIR"
  [[ -d "$CUSTOM_SKILLS_DIR" ]] || return 0
  local d name dest
  for d in "$CUSTOM_SKILLS_DIR"/*(N/); do
    name="${d:t}"
    dest="$AGENTS_SKILLS_DIR/$name"
    if [[ -e "$dest" || -L "$dest" ]]; then
      if [[ -L "$dest" && "$(readlink "$dest")" == "$d" ]]; then
        continue
      fi
      if (( FORCE )); then
        rm -rf "$dest"
      else
        warn "custom skill exists (not link to repo): $dest — use --force"
        continue
      fi
    fi
    log "link custom skill $name"
    ln -s "$d" "$dest"
  done
}

relink_opencode_skills() {
  mkdir -p "$OPENCODE_SKILLS_DIR" "$AGENTS_SKILLS_DIR"
  # remove managed links / empty; keep unknown non-links only with --force wipe of links
  local f
  for f in "$OPENCODE_SKILLS_DIR"/*(N); do
    [[ -e "$f" || -L "$f" ]] || continue
    if [[ -L "$f" ]]; then
      rm -f "$f"
    elif (( FORCE )); then
      rm -rf "$f"
    else
      warn "skip non-link in opencode skills: $f"
    fi
  done
  local s name
  for s in "$AGENTS_SKILLS_DIR"/*(N/); do
    name="${s:t}"
    ln -sfn "$s" "$OPENCODE_SKILLS_DIR/$name"
  done
  log "opencode skills linked ($(ls -1 "$OPENCODE_SKILLS_DIR" | wc -l | tr -d ' '))"
}

# pnpm/plugin install can replace stowed files with plain files — package wins
repair_opencode_stow() {
  local pkg_dir="$REPO/opencode"
  [[ -d "$pkg_dir" ]] || return 0
  log "repair opencode stow"
  local f rel dest
  while IFS= read -r -d '' f; do
    rel="${f#$pkg_dir/}"
    dest="$HOME_DIR/$rel"
    [[ -e "$dest" || -L "$dest" ]] || continue
    if is_repo_link "$dest"; then
      continue
    fi
    if [[ -L "$dest" ]]; then
      local abs="${dest:A}"
      [[ "$abs" == "$REPO"/* || "$abs" == "$f" ]] && continue
    fi
    log "remove stomped $dest"
    rm -rf "$dest"
  done < <(find "$pkg_dir" -type f -print0)
  stow -d "$REPO" -t "$HOME_DIR" -R opencode
}

opencode_pnpm() {
  [[ -f "$OPENCODE_DIR/package.json" ]] || return 0
  if command -v pnpm >/dev/null 2>&1; then
    log "pnpm install (opencode config)"
    # optional native builds (msgpackr-extract) may warn; never fail install
    (cd "$OPENCODE_DIR" && pnpm install --ignore-scripts >/dev/null) || true
    repair_opencode_stow
  else
    warn "pnpm not found; skip opencode plugin install"
  fi
}

check_drift() {
  log "check mode"
  local pkg
  for pkg in "${STOW_PACKAGES[@]}"; do
    stow -d "$REPO" -t "$HOME_DIR" -n -v "$pkg" 2>&1 || true
  done
  [[ -f "$SECRETS_PATH" ]] || warn "secrets missing"
  return 0
}

# --- main ---
cd "$REPO"

if (( CHECK_ONLY )); then
  check_drift
  exit 0
fi

if (( ! SKILLS_ONLY )); then
  ensure_brew
  brew_bundle
  ensure_stow
  clone_zsh_plugins
  for pkg in "${STOW_PACKAGES[@]}"; do
    stow_package "$pkg"
  done
  check_secrets
  opencode_pnpm
fi

install_skills_external
link_custom_skills
relink_opencode_skills

log "done"
if [[ ! -f "$SECRETS_PATH" || ! -f "$HOME_DIR/.gitconfig.local" ]]; then
  print -r -- ""
  print -r -- "Next (first machine):"
  [[ -f "$SECRETS_PATH" ]] || print -r -- "  cp $REPO/env.example ~/.config/secrets/env && chmod 600 ~/.config/secrets/env"
  [[ -f "$HOME_DIR/.gitconfig.local" ]] || print -r -- "  cp $REPO/gitconfig.local.example ~/.gitconfig.local   # edit name/email"
  [[ -f "$HOME_DIR/.zshenv.local" ]] || print -r -- "  cp $REPO/zshenv.local.example ~/.zshenv.local         # kube/ssh if needed"
  print -r -- "  open a new shell"
fi
