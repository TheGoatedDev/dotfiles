#!/usr/bin/env zsh
set -euo pipefail

REPO="${0:A:h}"
HOME_DIR="${HOME:A}"
FORCE=0
CHECK_ONLY=0
SKILLS_ONLY=0
STRICT_SECRETS=0
BREW_REINSTALL=0
BREW_REINSTALL_CASKS=0

usage() {
  cat <<'EOF'
Usage: ./install [options]

  --force             Backup conflicting files, then stow
  --reinstall         brew reinstall Brewfile formulae only (no casks / no sudo)
  --reinstall-casks   brew reinstall Brewfile casks only (Terminal + sudo -v)
  --check             Report drift only (no changes)
  --skills-only       Skills + Claude skill links only
  --strict            Fail if secrets file missing
  -h, --help          This help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE=1 ;;
    --reinstall) BREW_REINSTALL=1 ;;
    --reinstall-casks) BREW_REINSTALL_CASKS=1 ;;
    --check) CHECK_ONLY=1 ;;
    --skills-only) SKILLS_ONLY=1 ;;
    --strict) STRICT_SECRETS=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

log() { print -r -- "→ $*"; }
warn() { print -r -- "⚠ $*" >&2; }
die() { print -r -- "✗ $*" >&2; exit 1; }

expand_path() {
  local p="$1"
  p="${p/#\~/$HOME_DIR}"
  print -r -- "${p:A}"
}

STOW_PACKAGES=(zsh git ghostty tmux claude launchd)
ZSH_PLUGINS_DIR="$(expand_path ~/.zsh/plugins)"
ZSH_PLUGIN_REPOS=(
  https://github.com/zsh-users/zsh-autosuggestions
  https://github.com/zsh-users/zsh-syntax-highlighting
)
TMUX_PLUGINS_DIR="$(expand_path ~/.config/tmux/plugins)"
TMUX_PLUGIN_REPOS=(
  https://github.com/tmux-plugins/tpm
  https://github.com/tmux-plugins/tmux-sensible
  https://github.com/catppuccin/tmux
)
FREECAD_MOD_DIR="$(expand_path "~/Library/Application Support/FreeCAD/v1-1/Mod")"
# FreeCAD addons, cloned instead of via Addon Manager so they are tracked here.
FREECAD_ADDON_REPOS=(
  https://github.com/shaise/FreeCAD_FastenersWB
  https://github.com/APEbbers/FreeCAD-Ribbon
  https://github.com/obelisk79/FreeCAD-Nxt
  https://github.com/obelisk79/OpenTheme
  https://github.com/CREATeNG/freecad-mcp-bridge#release
)
MANIFEST="$REPO/manifest.yaml"
CUSTOM_SKILLS_DIR="$REPO/skills/custom"
AGENTS_SKILLS_DIR="$(expand_path ~/.agents/skills)"
CLAUDE_SKILLS_DIR="$(expand_path ~/.claude/skills)"
SECRETS_PATH="$(expand_path ~/.config/secrets/env)"
BREWFILE="$REPO/Brewfile"
BACKUP_ROOT="$(expand_path ~/.dotfiles-backup)/$(date +%Y%m%d-%H%M%S)"

ensure_brew() {
  if command -v brew >/dev/null 2>&1; then
    return 0
  fi
  log "Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv zsh)"
  fi
}

brew_reinstall_formulae() {
  [[ -f "$BREWFILE" ]] || die "Missing Brewfile"
  local line name
  log "brew reinstall (Brewfile formulae — no sudo)"
  export HOMEBREW_NO_ENV_HINTS=1
  while IFS= read -r line; do
    [[ "$line" == brew\ \"* ]] || continue
    name="${line#brew \"}"
    name="${name%%\"*}"
    [[ -n "$name" ]] || continue
    log "reinstall formula $name"
    brew reinstall "$name" || warn "reinstall failed: $name"
  done < "$BREWFILE"
}

# Casks that need multi-step privileged helpers — reinstall breaks mid-flight.
# Install/upgrade via normal `brew bundle` only; never brew reinstall.
CASK_REINSTALL_SKIP=(docker-desktop)

brew_reinstall_casks() {
  [[ -f "$BREWFILE" ]] || die "Missing Brewfile"
  local line name sudo_keeper=0 skip

  if [[ ! -t 0 || ! -t 1 || ! -t 2 ]]; then
    die "cask reinstall needs a real Terminal. Run:\n  cd $REPO && ./install --reinstall-casks"
  fi

  unset SUDO_ASKPASS SUDO_ASKPASS_REQUIRE
  log "admin password once (should stay hidden)…"
  if ! sudo -v; then
    die "sudo failed — wrong password or cancelled."
  fi

  # Refresh sudo every 10s so long casks (and brew's own sudo calls) stay authenticated
  (
    while true; do
      sudo -n true 2>/dev/null || exit 0
      sleep 10
    done
  ) &
  sudo_keeper=$!
  trap "kill $sudo_keeper 2>/dev/null || true" EXIT INT TERM

  export HOMEBREW_NO_ENV_HINTS=1
  log "brew reinstall (Brewfile casks; skips: ${(j:, :)CASK_REINSTALL_SKIP})"
  while IFS= read -r line; do
    [[ "$line" == cask\ \"* ]] || continue
    name="${line#cask \"}"
    name="${name%%\"*}"
    [[ -n "$name" ]] || continue
    skip=0
    for s in "${CASK_REINSTALL_SKIP[@]}"; do
      [[ "$name" == "$s" ]] && skip=1 && break
    done
    if (( skip )); then
      log "skip reinstall $name (use: brew install --cask $name)"
      continue
    fi
    # zulu@* are .pkg installers — reinstall is slow; only if missing from /Library/Java
    if [[ "$name" == zulu@* ]]; then
      if /usr/libexec/java_home -v "${name#zulu@}" >/dev/null 2>&1; then
        log "skip $name (JDK already registered)"
        continue
      fi
    fi
    log "reinstall cask $name"
    sudo -v 2>/dev/null || true
    brew reinstall --cask "$name" || warn "reinstall failed: $name"
  done < "$BREWFILE"

  kill $sudo_keeper 2>/dev/null || true
  trap - EXIT INT TERM
}

brew_bundle() {
  [[ -f "$BREWFILE" ]] || die "Missing Brewfile"
  if (( BREW_REINSTALL )); then
    brew_reinstall_formulae
  fi
  if (( BREW_REINSTALL_CASKS )); then
    brew_reinstall_casks
  fi
  log "brew bundle (no upgrade)"
  export HOMEBREW_NO_ENV_HINTS=1
  # Idempotent install only — don't pull multi‑GB cask upgrades mid-bootstrap
  brew bundle --file="$BREWFILE" --no-upgrade
}

ensure_stow() {
  command -v stow >/dev/null 2>&1 || brew install stow
}

backup_path() {
  local target="$1"
  local rel="${target#$HOME_DIR/}"
  local dest="$BACKUP_ROOT/$rel"
  mkdir -p "${dest:h}"
  mv "$target" "$dest"
  log "backed up $target → $dest"
}

# True if path is already a symlink into this repo
is_repo_link() {
  local target="$1"
  [[ -L "$target" ]] || return 1
  local resolved
  resolved="$(readlink "$target")"
  [[ "$resolved" == "$REPO"/* ]] && return 0
  # relative link: resolve
  local abs="${target:A}"
  [[ "$abs" == "$REPO"/* ]]
}

stow_package() {
  local pkg="$1"
  local pkg_dir="$REPO/$pkg"
  [[ -d "$pkg_dir" ]] || die "Missing package: $pkg"

  # Conflict scan: files that would be replaced
  local conflicts=()
  local f rel dest
  while IFS= read -r -d '' f; do
    rel="${f#$pkg_dir/}"
    dest="$HOME_DIR/$rel"
    [[ -e "$dest" || -L "$dest" ]] || continue
    if is_repo_link "$dest"; then
      continue
    fi
    # inside a folded dir link (stow linked the parent dir into the package)
    [[ "${dest:A}" == "$f" ]] && continue
    # already correct absolute link into package
    if [[ -L "$dest" ]]; then
      local link
      link="$(readlink "$dest")"
      [[ "$link" == "$pkg_dir/$rel" || "${dest:A}" == "$f" ]] && continue
    fi
    conflicts+=("$dest")
  done < <(find "$pkg_dir" -type f -print0)

  if (( ${#conflicts[@]} > 0 )); then
    if (( FORCE )); then
      mkdir -p "$BACKUP_ROOT"
      local c
      for c in "${conflicts[@]}"; do
        backup_path "$c"
      done
    else
      warn "Conflicts for package $pkg (re-run with --force):"
      print -l -- "${conflicts[@]}"
      die "stow aborted"
    fi
  fi

  log "stow $pkg"
  stow -d "$REPO" -t "$HOME_DIR" -R "$pkg"
}

clone_git_repos() {
  local dest_dir="$1"
  shift
  mkdir -p "$dest_dir"
  local url ref name dest
  for url in "$@"; do
    # url#branch clones that branch instead of the default
    ref="${url#*\#}"; [[ "$ref" == "$url" ]] && ref=""
    url="${url%%\#*}"
    name="${url:t}"
    name="${name%.git}"
    dest="$dest_dir/$name"
    if [[ -d "$dest/.git" ]]; then
      log "update plugin $name"
      git -C "$dest" pull --ff-only --quiet || warn "could not update $name"
    else
      log "clone plugin $name"
      git clone --depth 1 ${ref:+--branch=$ref} "$url" "$dest"
    fi
  done
}

clone_zsh_plugins() {
  clone_git_repos "$ZSH_PLUGINS_DIR" "${ZSH_PLUGIN_REPOS[@]}"
}

clone_tmux_plugins() {
  clone_git_repos "$TMUX_PLUGINS_DIR" "${TMUX_PLUGIN_REPOS[@]}"
}

clone_freecad_addons() {
  clone_git_repos "$FREECAD_MOD_DIR" "${FREECAD_ADDON_REPOS[@]}"
}

check_secrets() {
  if [[ -f "$SECRETS_PATH" ]]; then
    log "secrets ok ($SECRETS_PATH)"
    return 0
  fi
  warn "Missing secrets file: $SECRETS_PATH"
  warn "Copy $REPO/env.example → $SECRETS_PATH && chmod 600"
  (( STRICT_SECRETS )) && die "secrets required (--strict)"
}

install_skills_external() {
  [[ -f "$MANIFEST" ]] || { warn "no manifest.yaml"; return 0; }
  mkdir -p "$AGENTS_SKILLS_DIR" "$HOME_DIR/.agents"

  # packages: under skills: in manifest.yaml — source → list of skill names.
  # Skip if already present. Agent: claude-code.
  python3 - <<'PY' "$MANIFEST" "$AGENTS_SKILLS_DIR" "$CLAUDE_SKILLS_DIR" || true
import re, subprocess, sys
from pathlib import Path

text = Path(sys.argv[1]).read_text()
# skills CLI -a claude-code copies into ~/.claude/skills; older installs live in ~/.agents/skills
dirs = [Path(d) for d in sys.argv[2:4]]

# tiny indent walker for skills.packages only (no PyYAML)
lines = text.splitlines()
i = 0
in_skills = in_packages = False
skills_indent = packages_indent = None
packages: dict[str, list[str]] = {}
cur_src = None

while i < len(lines):
    raw = lines[i]
    i += 1
    if not raw.strip() or raw.lstrip().startswith("#"):
        continue
    indent = len(raw) - len(raw.lstrip(" "))
    s = raw.strip()
    if not in_skills:
        if s == "skills:" and indent == 0:
            in_skills = True
            skills_indent = indent
        continue
    if indent <= skills_indent and s.endswith(":") and s != "skills:":
        break
    if not in_packages:
        if s == "packages:":
            in_packages = True
            packages_indent = indent
        continue
    if indent <= packages_indent:
        break
    m_src = re.match(r"^([\w./-]+):\s*$", s)
    if m_src and indent == packages_indent + 2:
        cur_src = m_src.group(1)
        packages.setdefault(cur_src, [])
        continue
    m_item = re.match(r"^-\s+(\S+)\s*$", s)
    if m_item and cur_src is not None and indent > packages_indent + 2:
        packages[cur_src].append(m_item.group(1))

if not packages:
    print("⚠ no skills.packages in manifest.yaml", file=sys.stderr)
    sys.exit(0)

for src, names in packages.items():
    for skill in names:
        if any((d / skill).exists() for d in dirs):
            print(f"→ skills skip (present): {skill}")
            continue
        cmd = [
            "npx", "--yes", "skills", "add", src,
            "-g", "-y", "-s", skill, "-a", "claude-code",
        ]
        print(f"→ skills add {src} -s {skill} -a claude-code")
        subprocess.run(cmd, check=False)
PY
}

link_custom_skills() {
  mkdir -p "$AGENTS_SKILLS_DIR"
  [[ -d "$CUSTOM_SKILLS_DIR" ]] || return 0
  local d name dest
  for d in "$CUSTOM_SKILLS_DIR"/*(N/); do
    name="${d:t}"
    dest="$AGENTS_SKILLS_DIR/$name"
    if [[ -e "$dest" || -L "$dest" ]]; then
      if [[ -L "$dest" && "$(readlink "$dest")" == "$d" ]]; then
        continue
      fi
      if (( FORCE )); then
        rm -rf "$dest"
      else
        warn "custom skill exists (not link to repo): $dest — use --force"
        continue
      fi
    fi
    log "link custom skill $name"
    ln -s "$d" "$dest"
  done
}

# Claude Code: link ~/.agents/skills/* into ~/.claude/skills. Only manages links;
# Claude's own dirs (e.g. synced/) are left alone.
relink_claude_skills() {
  mkdir -p "$CLAUDE_SKILLS_DIR"
  local f s name
  for f in "$CLAUDE_SKILLS_DIR"/*(N@); do
    rm -f "$f"
  done
  for s in "$AGENTS_SKILLS_DIR"/*(N-/); do
    name="${s:t}"
    if [[ -e "$CLAUDE_SKILLS_DIR/$name" ]]; then
      warn "skip non-link in claude skills: $CLAUDE_SKILLS_DIR/$name"
      continue
    fi
    ln -s "$s" "$CLAUDE_SKILLS_DIR/$name"
  done
  log "claude skills linked ($(find "$CLAUDE_SKILLS_DIR" -maxdepth 1 -type l | wc -l | tr -d ' '))"
}

# Claude plugins: marketplace name, source (pin with #tag), plugin name.
# posthog ships its MCP server; the official marketplace pins it by SHA.
CLAUDE_PLUGINS=(
  caveman 'https://github.com/JuliusBrussee/caveman.git#v3.1.0' caveman
  ponytail 'https://github.com/DietrichGebert/ponytail.git#v5.1.0' ponytail
  impeccable 'https://github.com/pbakaus/impeccable.git#skill-v4.8.0' impeccable
  # rea: tags lack .claude-plugin/ and #ref can't be a SHA; main's marketplace.json pins npm rea-agents
  rea 'https://github.com/morluto/rea.git' rea
  claude-plugins-official anthropics/claude-plugins-official posthog
)

# Plugin parts to hide (Claude can't disable single plugin components).
# Merged into ~/.claude/settings.json permissions.deny, plus empty
# attribution (no Co-Authored-By / PR footer); nothing else touched.
CLAUDE_DENY=(
  'Skill(caveman:cavecrew)'
  'Agent(caveman:cavecrew-builder)'
  'Agent(caveman:cavecrew-investigator)'
  'Agent(caveman:cavecrew-reviewer)'
)

claude_deny_rules() {
  python3 - "$HOME_DIR/.claude/settings.json" "${CLAUDE_DENY[@]}" <<'PY2' || warn "claude deny rules failed"
import json, sys
from pathlib import Path
path, rules = Path(sys.argv[1]), sys.argv[2:]
data = json.loads(path.read_text()) if path.exists() else {}
deny = data.setdefault("permissions", {}).setdefault("deny", [])
new = [r for r in rules if r not in deny]
attribution = {"commit": "", "pr": ""}
changed = bool(new) or data.get("attribution") != attribution
if new:
    deny.extend(new)
    print(f"→ claude deny: {', '.join(new)}")
if data.get("attribution") != attribution:
    data["attribution"] = attribution
    print("→ claude attribution off")
if changed:
    path.write_text(json.dumps(data, indent=2) + "\n")
PY2
}

claude_setup() {
  if ! command -v claude >/dev/null 2>&1; then
    warn "claude not found; skip Claude Code plugin/hook setup"
    return 0
  fi
  # Claude plugins: marketplace (git URL pinned with #ref) + plugin@marketplace.
  # caveman: always-on via SessionStart hook.
  # capture first: grep -q + pipefail would SIGPIPE the producer
  local market ref plugin markets plugins
  markets="$(claude plugin marketplace list 2>/dev/null || true)"
  plugins="$(claude plugin list 2>/dev/null || true)"
  for market ref plugin in "${CLAUDE_PLUGINS[@]}"; do
    if ! grep -q "❯ $market\$" <<<"$markets"; then
      log "claude marketplace add $market ($ref)"
      claude plugin marketplace add "$ref" >/dev/null || { warn "marketplace add failed: $market"; continue; }
    fi
    grep -q "❯ $plugin@$market\$" <<<"$plugins" && continue
    log "claude plugin install $plugin@$market"
    claude plugin install "$plugin@$market" >/dev/null || warn "plugin install failed: $plugin@$market"
  done
  # shortcut: npm rea-agents@6.8.0 lacks .claude-plugin/plugin.json, so rea@rea brings only the skill; drop once a release ships it.
  if ! claude mcp get rea >/dev/null 2>&1; then
    log "claude mcp add rea"
    claude mcp add -s user rea -- npx -y rea-agents@6.8.0 mcp >/dev/null || warn "claude mcp add failed: rea"
  fi
  # FreeCAD MCP Bridge addon: loopback only, listens only while toggled on in FreeCAD.
  if ! claude mcp get freecad >/dev/null 2>&1; then
    log "claude mcp add freecad"
    claude mcp add -s user -t http freecad http://127.0.0.1:39280/mcp >/dev/null || warn "claude mcp add failed: freecad"
  fi
  claude_deny_rules
  # RTK hook in ~/.claude/settings.json
  if command -v rtk >/dev/null 2>&1 && ! grep -q '^\[ok\] Hook' <<<"$(rtk init --show 2>/dev/null || true)"; then
    log "rtk hook (claude)"
    rtk init -g --hook-only --auto-patch >/dev/null || warn "rtk init failed"
  fi
}

# Load stowed LaunchAgents not yet in launchd (already-loaded left alone)
load_launch_agents() {
  local plist label
  for plist in "$REPO"/launchd/Library/LaunchAgents/*.plist(N); do
    label="${plist:t:r}"
    launchctl print "gui/$UID/$label" >/dev/null 2>&1 && continue
    log "launchctl bootstrap $label"
    launchctl bootstrap "gui/$UID" "$HOME_DIR/Library/LaunchAgents/${plist:t}" || warn "bootstrap failed: $label"
  done
}

check_drift() {
  log "check mode"
  local pkg
  for pkg in "${STOW_PACKAGES[@]}"; do
    stow -d "$REPO" -t "$HOME_DIR" -n -v "$pkg" 2>&1 || true
  done
  [[ -f "$SECRETS_PATH" ]] || warn "secrets missing"
  return 0
}

# --- main ---
cd "$REPO"

if (( CHECK_ONLY )); then
  check_drift
  exit 0
fi

if (( ! SKILLS_ONLY )); then
  ensure_brew
  brew_bundle
  ensure_stow
  clone_zsh_plugins
  clone_tmux_plugins
  clone_freecad_addons
  for pkg in "${STOW_PACKAGES[@]}"; do
    stow_package "$pkg"
  done
  load_launch_agents
  check_secrets
  claude_setup
fi

install_skills_external
link_custom_skills
relink_claude_skills

log "done"
if [[ ! -f "$SECRETS_PATH" || ! -f "$HOME_DIR/.gitconfig.local" ]]; then
  print -r -- ""
  print -r -- "Next (first machine):"
  [[ -f "$SECRETS_PATH" ]] || print -r -- "  cp $REPO/env.example ~/.config/secrets/env && chmod 600 ~/.config/secrets/env"
  [[ -f "$HOME_DIR/.gitconfig.local" ]] || print -r -- "  cp $REPO/gitconfig.local.example ~/.gitconfig.local   # edit name/email"
  [[ -f "$HOME_DIR/.zshenv.local" ]] || print -r -- "  cp $REPO/zshenv.local.example ~/.zshenv.local         # kube/ssh if needed"
  print -r -- "  open a new shell"
fi
